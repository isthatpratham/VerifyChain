# VITE_API_BASE_URL: Optional API base URL override.
# Defaults to '/api', which works seamlessly with the Vite dev proxy locally and on Vercel same-domain deployments.
# Set only if your backend API is hosted on an external or different domain.
# VITE_API_BASE_URL=/api

# VITE_APP_URL: Optional canonical public application URL override.
# Defaults to window.location.origin in the browser, which works automatically on Vercel Preview and Production deployments.
# Set explicitly if you wish to override public share links and QR destinations at build time.
# VITE_APP_URL=https://your-domain.com
