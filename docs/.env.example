# VerifyChain — Environment Variables
# Copy to .env and fill in your values.
# Never commit the actual .env file to git.

# ─── DATABASE ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/verifychain"

# ─── AUTHENTICATION ────────────────────────────────────────────────────────────
# JWT signing secret — minimum 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-real-secret-minimum-32-characters"

# JWT token expiry duration
JWT_EXPIRY="7d"

# ─── SERVER ────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# ─── EMAIL (Nodemailer + Gmail SMTP — FREE) ────────────────────────────────────
# Use a Gmail account with 2FA enabled.
# Generate an App Password at: https://myaccount.google.com/apppasswords
# IMPORTANT: Use the App Password here, NOT your regular Gmail password.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="yourteam@gmail.com"
EMAIL_PASS="your-gmail-app-password-16-chars"
EMAIL_FROM="VerifyChain Alerts <yourteam@gmail.com>"

# ─── FILE UPLOADS ──────────────────────────────────────────────────────────────
# Maximum file size for document uploads (in bytes)
# Default: 5MB = 5242880 bytes
MAX_FILE_SIZE_BYTES=5242880

# Upload directory path (relative to server/ root)
UPLOAD_DIR="uploads"

# ─── ALERT ENGINE ──────────────────────────────────────────────────────────────
# Cron schedule for daily alert job (default: 08:00 IST = 02:30 UTC)
# Format: second minute hour day month weekday
ALERT_CRON_SCHEDULE="30 2 * * *"

# Compliance refresh cooldown (hours)
COMPLIANCE_REFRESH_COOLDOWN_HOURS=24

# ─── AI (OPTIONAL — LOCAL OLLAMA, FREE) ────────────────────────────────────────
# URL for local Ollama instance.
# Install: https://ollama.com/download
# Run model: ollama run llama3
# The application works fully without this — scheme explanation degrades gracefully.
# OPTIONAL — leave as-is if Ollama is not installed.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# ─── NOTES ─────────────────────────────────────────────────────────────────────
# This project runs entirely on localhost.
# No paid services are used anywhere.
# No cloud credentials are required.
# Do NOT add: AWS keys, Twilio, Razorpay, Firebase, or any paid API key.
# The Gmail SMTP setup is free — no paid email service.
