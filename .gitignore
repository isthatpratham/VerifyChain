package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime Data
pids/
*.pid
*.seed
*.pid.lock

# Environment Variables
.env
.env.*
!.env.example
!.env*.example

# Build Output
dist/
build/
out/
.next/
.vercel/
.turbo/
.cache/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Testing
playwright-report/
test-results/
*.lcov

# Prisma
prisma/dev.db
prisma/dev.db-journal

# Database
*.sqlite
*.sqlite3
*.db

# Docker
.docker/
docker-data/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# Temporary Files
tmp/
temp/
*.tmp
*.temp

# Cache
.eslintcache
.stylelintcache
.cache-loader/
.parcel-cache/

# Uploads
uploads/
storage/
public/uploads/

# Certificates & Secrets
*.pem
*.key
*.crt
*.cert
secrets/
credentials/

# Firebase
firebase-debug.log
.firebaserc.local

# Local Development
.local/
.localhistory/

