generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────

enum UserRole {
  MSME_OWNER
  BUYER
  ADMIN
}

enum IntegrationStatus {
  DRAFT
  CONFIGURED
  CONNECTED
  ACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}

enum IntegrationType {
  ERP
  CRM
  GOVERNMENT
  OAUTH
  WEBHOOK
  PARTNER
  CUSTOM
}

enum ApiKeyStatus {
  ACTIVE
  ROTATED
  EXPIRED
  REVOKED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRIED
  PERMANENTLY_FAILED
}

enum BusinessType {
  MANUFACTURING
  SERVICES
  TRADING
  FOOD_PROCESSING
  CONSTRUCTION
  OTHER
}

enum ComplianceStatus {
  COMPLIANT
  DUE
  OVERDUE
  EXEMPT
  UNKNOWN
}

enum CompliancePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RenewalFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  ONE_TIME
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum RuleStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

enum AlertThreshold {
  DAYS_30
  DAYS_15
  DAYS_7
}

enum DocumentType {
  GST_CERTIFICATE
  EPFO_CERTIFICATE
  ESIC_CERTIFICATE
  MCA_CERTIFICATE
  UDYAM_CERTIFICATE
  FSSAI_LICENSE
  FACTORY_LICENSE
  OTHER
}

enum AuthorityType {
  GST
  EPFO
  ESIC
  MCA
  UDYAM
  FSSAI
}

enum TrustLevel {
  PENDING
  VERIFIED
  TRUSTED
  HIGHLY_TRUSTED
  ENTERPRISE_TRUSTED
  SUSPENDED
  EXPIRED
  REVOKED
}

enum VerificationState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
  REVOKED
  ARCHIVED
}

enum DistributionChannel {
  QR_CODE
  TRUST_CARD
  CERTIFICATE
  EMBED_BADGE
  WIDGET
  PUBLIC_LINK
  MOBILE_WALLET
}

enum DistributionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
  ARCHIVED
}

// ─── USERS ──────────────────────────────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String
  phone         String?
  role          UserRole @default(MSME_OWNER)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  msme_profile MsmeProfile?

  @@map("users")
}

// ─── MSME PROFILES ──────────────────────────────────────────────

model MsmeProfile {
  id                   Int          @id @default(autoincrement())
  user_id              Int          @unique
  business_name        String
  gstin                String       @unique
  udyam_number         String       @unique
  business_type        BusinessType
  sector               String
  state                String
  district             String
  employee_count       Int          @default(0)
  annual_turnover_lakh Float?
  is_food_business     Boolean      @default(false)
  is_profile_complete  Boolean      @default(false)
  last_compliance_sync DateTime?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  user                  User                   @relation(fields: [user_id], references: [id])
  compliance_records    ComplianceRecord[]
  documents             Document[]
  alerts                Alert[]
  scheme_matches        SchemeMatch[]
  buyer_view_logs       BuyerViewLog[]
  rule_evaluation_logs  RuleEvaluationLog[]
  health_score_snapshots HealthScoreSnapshot[]
  supplier_trust_profile SupplierTrustProfile?

  @@index([gstin])
  @@index([udyam_number])
  @@map("msme_profiles")
}

// ─── SUPPLIER TRUST PROFILES ────────────────────────────────────

model SupplierTrustProfile {
  id                   Int               @id @default(autoincrement())
  msme_id              Int               @unique
  public_slug          String            @unique
  public_identifier    String            @unique
  display_name         String
  trust_level          TrustLevel        @default(PENDING)
  verification_state   VerificationState @default(DRAFT)
  is_public            Boolean           @default(false)
  trust_score_snapshot Float?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt

  msme_profile              MsmeProfile                @relation(fields: [msme_id], references: [id])
  trust_metadata            TrustMetadata[]
  timeline_events           TrustTimelineEvent[]
  trust_distribution_identity TrustDistributionIdentity?

  @@index([public_slug])
  @@index([public_identifier])
  @@index([trust_level])
  @@map("supplier_trust_profiles")
}

// ─── TRUST METADATA ─────────────────────────────────────────────

model TrustMetadata {
  id                        Int      @id @default(autoincrement())
  supplier_trust_profile_id Int
  verified_by               String?
  verification_version      String   @default("v1.0.0")
  confidence_score          Float    @default(0)
  review_cycle              String   @default("ANNUAL")
  next_review_date          DateTime?
  expiration_date           DateTime?
  metadata_json             Json?
  created_at                DateTime @default(now())

  supplier_trust_profile SupplierTrustProfile @relation(fields: [supplier_trust_profile_id], references: [id])

  @@index([supplier_trust_profile_id])
  @@map("trust_metadata")
}

// ─── TRUST TIMELINE EVENTS ─────────────────────────────────────

model TrustTimelineEvent {
  id                        Int      @id @default(autoincrement())
  supplier_trust_profile_id Int
  event_type                String
  title                     String
  description               String
  actor                     String   @default("SYSTEM")
  event_data                Json?
  created_at                DateTime @default(now())

  supplier_trust_profile SupplierTrustProfile @relation(fields: [supplier_trust_profile_id], references: [id])

  @@index([supplier_trust_profile_id])
  @@index([created_at])
  @@map("trust_timeline_events")
}

// ─── TRUST DISTRIBUTION IDENTITIES ──────────────────────────────

model TrustDistributionIdentity {
  id                        Int                @id @default(autoincrement())
  supplier_trust_profile_id Int                @unique
  public_slug               String
  stable_distribution_id    String             @unique
  asset_version             String             @default("v1.0.0")
  status                    DistributionStatus @default(ACTIVE)
  enabled_channels          String[]           @default(["PUBLIC_LINK", "QR_CODE", "TRUST_CARD"])
  created_at                DateTime           @default(now())
  updated_at                DateTime           @updatedAt

  supplier_trust_profile SupplierTrustProfile           @relation(fields: [supplier_trust_profile_id], references: [id])
  config                 TrustDistributionConfig?
  timeline_events        TrustDistributionTimelineEvent[]

  @@index([public_slug])
  @@index([stable_distribution_id])
  @@map("trust_distribution_identities")
}

// ─── TRUST DISTRIBUTION CONFIGS ──────────────────────────────────

model TrustDistributionConfig {
  id                             Int      @id @default(autoincrement())
  trust_distribution_identity_id Int      @unique
  branding_json                  Json?
  visibility_json                Json?
  token_policy_json              Json?
  expiration_days                Int      @default(365)
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt

  trust_distribution_identity TrustDistributionIdentity @relation(fields: [trust_distribution_identity_id], references: [id])

  @@map("trust_distribution_configs")
}

// ─── TRUST DISTRIBUTION TIMELINE EVENTS ───────────────────────────

model TrustDistributionTimelineEvent {
  id                             Int      @id @default(autoincrement())
  trust_distribution_identity_id Int
  event_type                     String
  title                          String
  description                    String?
  actor                          String   @default("SYSTEM")
  event_data                     Json?
  created_at                     DateTime @default(now())

  trust_distribution_identity TrustDistributionIdentity @relation(fields: [trust_distribution_identity_id], references: [id])

  @@index([trust_distribution_identity_id])
  @@index([created_at])
  @@map("trust_distribution_timeline_events")
}

// ─── COMPLIANCE RECORDS ─────────────────────────────────────────

model ComplianceRecord {
  id                Int                @id @default(autoincrement())
  msme_id           Int
  authority         AuthorityType
  status            ComplianceStatus   @default(UNKNOWN)
  priority          CompliancePriority @default(MEDIUM)
  renewal_frequency RenewalFrequency   @default(ANNUAL)
  risk_level        RiskLevel          @default(LOW)
  expiry_date       DateTime?
  last_checked      DateTime           @default(now())
  last_filed        DateTime?
  filing_reference  String?
  notes             String?
  raw_data          Json?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  msme_profile MsmeProfile @relation(fields: [msme_id], references: [id])
  alerts       Alert[]

  @@unique([msme_id, authority])
  @@index([msme_id])
  @@index([status])
  @@index([expiry_date])
  @@map("compliance_records")
}

// ─── COMPLIANCE RULES ───────────────────────────────────────────

model ComplianceRule {
  id                  Int                @id @default(autoincrement())
  rule_id             String             @unique
  rule_name           String
  description         String
  version             Int                @default(1)
  status              RuleStatus         @default(ACTIVE)
  priority            CompliancePriority @default(MEDIUM)
  authority           AuthorityType
  legal_reference     String?
  effective_date      DateTime?
  expiry_date         DateTime?
  conditions          Json
  success_explanation String
  failure_explanation String
  tags                String[]           @default([])
  metadata            Json?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  evaluation_logs RuleEvaluationLog[]

  @@index([authority])
  @@index([status])
  @@index([rule_id])
  @@map("compliance_rules")
}

// ─── RULE EVALUATION LOGS ───────────────────────────────────────

model RuleEvaluationLog {
  id                 Int      @id @default(autoincrement())
  msme_id            Int
  rule_id            Int
  evaluated_at       DateTime @default(now())
  execution_time_ms  Float
  is_applicable      Boolean
  matched_conditions Json
  explanation        String
  input_snapshot     Json
  engine_version     String   @default("1.0.0")

  msme_profile    MsmeProfile    @relation(fields: [msme_id], references: [id])
  compliance_rule ComplianceRule @relation(fields: [rule_id], references: [id])

  @@index([msme_id])
  @@index([rule_id])
  @@index([evaluated_at])
  @@map("rule_evaluation_logs")
}

// ─── HEALTH SCORE CONFIGURATIONS ────────────────────────────────

model HealthScoreConfig {
  id                   Int        @id @default(autoincrement())
  config_version       String     @unique
  max_score            Int        @default(100)
  min_score            Int        @default(0)
  category_definitions Json
  penalty_rules        Json
  bonus_rules          Json
  status               RuleStatus @default(ACTIVE)
  effective_date       DateTime   @default(now())
  expiry_date          DateTime?
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt

  @@map("health_score_configs")
}

// ─── SCORE CATEGORIES ────────────────────────────────────────────

model ScoreCategory {
  id             Int      @id @default(autoincrement())
  category_code  String   @unique
  category_name  String
  description    String
  default_weight Float    @default(1.0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  @@map("score_categories")
}

// ─── HEALTH SCORE SNAPSHOTS ─────────────────────────────────────

model HealthScoreSnapshot {
  id                      Int       @id @default(autoincrement())
  msme_id                 Int
  config_version          String
  overall_score           Float?
  risk_level              RiskLevel @default(LOW)
  category_breakdown      Json?
  recommendations_snapshot Json?
  evaluated_at            DateTime  @default(now())
  engine_version          String    @default("1.0.0")

  msme_profile MsmeProfile @relation(fields: [msme_id], references: [id])

  @@index([msme_id])
  @@index([evaluated_at])
  @@map("health_score_snapshots")
}

// ─── DOCUMENTS ──────────────────────────────────────────────────

model Document {
  id            Int           @id @default(autoincrement())
  msme_id       Int
  document_type DocumentType
  authority     AuthorityType
  file_name     String
  file_path     String
  file_size_kb  Int
  validity_date DateTime?
  uploaded_at   DateTime      @default(now())
  notes         String?

  msme_profile MsmeProfile @relation(fields: [msme_id], references: [id])

  @@index([msme_id])
  @@index([authority])
  @@map("documents")
}

// ─── ALERTS ─────────────────────────────────────────────────────

model Alert {
  id                   Int            @id @default(autoincrement())
  msme_id              Int
  compliance_record_id Int
  threshold            AlertThreshold
  status               AlertStatus    @default(PENDING)
  scheduled_for        DateTime
  sent_at              DateTime?
  failure_reason       String?
  created_at           DateTime       @default(now())

  msme_profile      MsmeProfile      @relation(fields: [msme_id], references: [id])
  compliance_record ComplianceRecord @relation(fields: [compliance_record_id], references: [id])

  @@unique([msme_id, compliance_record_id, threshold])
  @@index([msme_id])
  @@index([status])
  @@index([scheduled_for])
  @@map("alerts")
}

// ─── GOVERNMENT SCHEMES ─────────────────────────────────────────

model GovernmentScheme {
  id                   Int      @id @default(autoincrement())
  scheme_name          String
  ministry             String
  description          String
  eligibility_criteria Json
  benefit_type         String
  max_benefit_lakh     Float?
  application_url      String
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())

  scheme_matches SchemeMatch[]

  @@index([ministry])
  @@map("government_schemes")
}

// ─── SCHEME MATCHES ─────────────────────────────────────────────

model SchemeMatch {
  id            Int      @id @default(autoincrement())
  msme_id       Int
  scheme_id     Int
  match_score   Int
  match_reasons Json
  matched_at    DateTime @default(now())

  msme_profile      MsmeProfile      @relation(fields: [msme_id], references: [id])
  government_scheme GovernmentScheme @relation(fields: [scheme_id], references: [id])

  @@unique([msme_id, scheme_id])
  @@index([msme_id])
  @@index([match_score])
  @@map("scheme_matches")
}

// ─── BUYER VIEW LOGS ────────────────────────────────────────────

model BuyerViewLog {
  id         Int      @id @default(autoincrement())
  msme_id    Int
  viewed_at  DateTime @default(now())
  viewer_ip  String?
  user_agent String?

  msme_profile MsmeProfile @relation(fields: [msme_id], references: [id])

  @@index([msme_id])
  @@index([viewed_at])
  @@map("buyer_view_logs")
}

// ─── INTEGRATION PLATFORM (PHASE 8.1) ───────────────────────────

model Integration {
  id               Int               @id @default(autoincrement())
  integration_id   String            @unique
  name             String
  description      String?
  type             IntegrationType   @default(CUSTOM)
  provider_code    String
  version          String            @default("v1.0.0")
  status           IntegrationStatus @default(DRAFT)
  is_system        Boolean           @default(false)
  capabilities     String[]          @default([])
  metadata         Json?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  configurations IntegrationConfiguration[]
  connections    IntegrationConnection[]
  events         IntegrationEventLog[]

  @@index([provider_code])
  @@index([type])
  @@index([status])
  @@map("integrations")
}

model IntegrationConfiguration {
  id                Int      @id @default(autoincrement())
  integration_id    Int
  msme_id           Int?
  environment       String   @default("PRODUCTION")
  config_version    String   @default("v1.0.0")
  base_url          String?
  auth_type         String   @default("API_KEY")
  settings_json     Json?
  timeout_ms        Int      @default(10000)
  retry_policy_json Json?
  rate_limit_rpm    Int      @default(120)
  is_enabled        Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  integration Integration         @relation(fields: [integration_id], references: [id])
  secrets     IntegrationSecret[]

  @@index([integration_id])
  @@index([msme_id])
  @@map("integration_configurations")
}

model IntegrationSecret {
  id                   Int      @id @default(autoincrement())
  configuration_id     Int
  secret_key           String
  encrypted_value      String
  encryption_algorithm String   @default("AES-256-GCM")
  key_version          String   @default("v1")
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  configuration IntegrationConfiguration @relation(fields: [configuration_id], references: [id])

  @@index([configuration_id])
  @@map("integration_secrets")
}

model IntegrationConnection {
  id                    Int               @id @default(autoincrement())
  integration_id        Int
  msme_id               Int
  connection_identifier String            @unique
  status                IntegrationStatus @default(CONFIGURED)
  health_status         String            @default("HEALTHY")
  last_connected_at     DateTime?
  last_synced_at        DateTime?
  error_message         String?
  metadata              Json?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  integration Integration @relation(fields: [integration_id], references: [id])

  @@index([integration_id])
  @@index([msme_id])
  @@map("integration_connections")
}

model DeveloperApplication {
  id          Int      @id @default(autoincrement())
  msme_id     Int
  app_id      String   @unique
  name        String
  description String?
  environment String   @default("SANDBOX")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  api_keys              ApiKey[]
  webhook_subscriptions WebhookSubscription[]

  @@index([msme_id])
  @@index([app_id])
  @@map("developer_applications")
}

model ApiKey {
  id                Int          @id @default(autoincrement())
  developer_app_id  Int
  key_prefix        String
  key_hash          String       @unique
  name              String
  environment       String       @default("PRODUCTION")
  scopes            String[]     @default([])
  status            ApiKeyStatus @default(ACTIVE)
  expires_at        DateTime?
  last_used_at      DateTime?
  revoked_at        DateTime?
  revocation_reason String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  developer_app DeveloperApplication @relation(fields: [developer_app_id], references: [id])
  usage_logs    ApiKeyUsage[]

  @@index([developer_app_id])
  @@index([key_hash])
  @@index([status])
  @@map("api_keys")
}

model ApiKeyUsage {
  id               Int      @id @default(autoincrement())
  api_key_id       Int
  endpoint         String
  http_method      String
  status_code      Int
  response_time_ms Float
  request_ip       String?
  user_agent       String?
  created_at       DateTime @default(now())

  api_key ApiKey @relation(fields: [api_key_id], references: [id])

  @@index([api_key_id])
  @@index([created_at])
  @@map("api_key_usage")
}

model WebhookSubscription {
  id                Int      @id @default(autoincrement())
  developer_app_id  Int
  subscription_id   String   @unique
  target_url        String
  subscribed_events String[] @default([])
  secret_hash       String
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  developer_app DeveloperApplication @relation(fields: [developer_app_id], references: [id])
  deliveries    WebhookDelivery[]

  @@index([developer_app_id])
  @@index([subscription_id])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id              Int                   @id @default(autoincrement())
  subscription_id Int
  event_type      String
  event_id        String
  payload_json    Json
  status          WebhookDeliveryStatus @default(PENDING)
  attempt_count   Int                   @default(0)
  next_retry_at   DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  subscription WebhookSubscription @relation(fields: [subscription_id], references: [id])
  attempts     WebhookAttempt[]

  @@index([subscription_id])
  @@index([status])
  @@map("webhook_deliveries")
}

model WebhookAttempt {
  id                Int      @id @default(autoincrement())
  delivery_id       Int
  response_status   Int?
  response_body     String?
  execution_time_ms Float
  error_message     String?
  attempted_at      DateTime @default(now())

  delivery WebhookDelivery @relation(fields: [delivery_id], references: [id])

  @@index([delivery_id])
  @@map("webhook_attempts")
}

model IntegrationEventLog {
  id             Int      @id @default(autoincrement())
  integration_id Int?
  event_type     String
  event_source   String   @default("VERIFYCHAIN_INTERNAL")
  correlation_id String
  payload_json   Json
  created_at     DateTime @default(now())

  integration Integration? @relation(fields: [integration_id], references: [id])

  @@index([integration_id])
  @@index([event_type])
  @@index([correlation_id])
  @@map("integration_event_logs")
}

model IntegrationAuditLog {
  id             Int      @id @default(autoincrement())
  msme_id        Int?     @default(1)
  actor_type     String   @default("SYSTEM")
  actor_id       String
  module         String   @default("SYSTEM")
  action         String
  resource_type  String
  resource_id    String
  severity       String   @default("INFO")
  status         String   @default("SUCCESS")
  correlation_id String?
  changes_json   Json?
  ip_address     String?
  user_agent     String?
  created_at     DateTime @default(now())

  @@index([msme_id])
  @@index([module])
  @@index([severity])
  @@index([status])
  @@index([action])
  @@index([resource_type, resource_id])
  @@index([created_at])
  @@map("integration_audit_logs")
}

model DeveloperWorkspace {
  id          Int      @id @default(autoincrement())
  msme_id     Int
  name        String
  environment String   @default("PRODUCTION")
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([msme_id])
  @@map("developer_workspaces")
}

model SavedFilter {
  id               Int      @id @default(autoincrement())
  msme_id          Int
  developer_app_id Int?
  name             String
  category         String   @default("GLOBAL")
  filter_json      Json
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([msme_id])
  @@index([category])
  @@map("saved_filters")
}

model DashboardPreference {
  id                 Int      @id @default(autoincrement())
  msme_id            Int      @unique
  theme              String   @default("LIGHT")
  default_view       String   @default("OVERVIEW")
  widget_config_json Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("dashboard_preferences")
}

model APIUsageSummary {
  id                  Int      @id @default(autoincrement())
  developer_app_id    Int
  date                DateTime
  total_requests      Int      @default(0)
  successful_requests Int      @default(0)
  failed_requests     Int      @default(0)
  avg_latency_ms      Float    @default(0.0)
  peak_rpm            Int      @default(0)
  created_at          DateTime @default(now())

  @@index([developer_app_id])
  @@index([date])
  @@map("api_usage_summaries")
}

model SecurityAlert {
  id            Int       @id @default(autoincrement())
  msme_id       Int
  alert_type    String
  severity      String    @default("MEDIUM")
  title         String
  description   String
  metadata_json Json?
  is_resolved   Boolean   @default(false)
  resolved_at   DateTime?
  created_at    DateTime  @default(now())

  @@index([msme_id])
  @@index([severity])
  @@index([is_resolved])
  @@map("security_alerts")
}

model ConnectorPreference {
  id                     Int      @id @default(autoincrement())
  integration_id         Int
  msme_id                Int
  sync_schedule_cron     String?
  auto_resolve_conflicts Boolean  @default(false)
  settings_json          Json?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([integration_id, msme_id])
  @@map("connector_preferences")
}

model RecentActivity {
  id            Int      @id @default(autoincrement())
  msme_id       Int
  activity_type String
  description   String
  metadata_json Json?
  created_at    DateTime @default(now())

  @@index([msme_id])
  @@index([created_at])
  @@map("recent_activities")
}

model AuditBookmark {
  id           Int      @id @default(autoincrement())
  msme_id      Int
  audit_log_id Int
  note         String?
  created_at   DateTime @default(now())

  @@index([msme_id])
  @@map("audit_bookmarks")
}

model NotificationPreference {
  id                     Int      @id @default(autoincrement())
  msme_id                Int      @unique
  email_alerts           Boolean  @default(true)
  security_alerts        Boolean  @default(true)
  webhook_failures_alert Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@map("notification_preferences")
}
