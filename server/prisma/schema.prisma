  asset_id        Int
  status          String     @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, EXECUTED, CANCELLED
  disposition_type String    @default("SECURE_DESTROY") // SECURE_DESTROY, PERMANENT_ARCHIVE, ANONYMIZE
  reviewed_by     String?
  reviewed_at     DateTime?
  review_notes    String?
  executed_by     String?
  executed_at     DateTime?
  created_at      DateTime   @default(now())

  asset           VaultAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id])
  @@index([status])
  @@map("vault_disposition_records")
}

model VaultGovernanceReport {
  id          Int      @id @default(autoincrement())
  report_id   String   @unique @default(uuid())
  msme_id     Int      @default(1)
  title       String
  report_type String   // RETENTION_COMPLIANCE, LEGAL_HOLDS, ARCHIVE_ACTIVITY, DISPOSITION_ACTIVITY, GOVERNANCE_HEALTH
  data        Json
  created_by  String   @default("SYSTEM")
  created_at  DateTime @default(now())

  @@index([msme_id])
  @@index([report_type])
  @@map("vault_governance_reports")
}











