DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/verifychain"
JWT_SECRET="replace-with-a-real-secret-minimum-32-characters"
JWT_EXPIRY="7d"
PORT=5000
# Canonical Public Frontend Origin (required HTTPS in production):
# In local dev: "http://localhost:3000"
# In production / Vercel: "https://your-domain.com" (or your canonical Vercel production domain)
CLIENT_URL="http://localhost:3000"
# Optional comma-separated CORS allowed origins list:
# CORS_ORIGINS="https://your-domain.com,https://preview.your-domain.com"
NODE_ENV="development"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="yourteam@gmail.com"
EMAIL_PASS="your-gmail-app-password-16-chars"
EMAIL_FROM="VerifyChain Alerts <yourteam@gmail.com>"
MAX_FILE_SIZE_BYTES=5242880
UPLOAD_DIR="uploads"
ALERT_CRON_SCHEDULE="30 2 * * *"
COMPLIANCE_REFRESH_COOLDOWN_HOURS=24
